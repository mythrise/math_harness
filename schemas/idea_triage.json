{
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idea_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
            },
            "minItems": 0
          },
          "disposition": {
            "enum": [
              "CANDIDATE",
              "REJECT",
              "DEFER",
              "CONFLICT"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 12
          },
          "validation_plan": {
            "type": "string",
            "minLength": 12
          }
        },
        "required": [
          "idea_id",
          "question_ids",
          "disposition",
          "reason",
          "validation_plan"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "INFO"
            ]
          },
          "affects_stage": {
            "enum": [
              "intake",
              "modeling",
              "code",
              "experiment",
              "paper"
            ]
          },
          "idea_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
            },
            "minItems": 0
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "DEFERRED"
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "affects_stage",
          "idea_ids",
          "issue",
          "required_action",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "baseline_policy": {
      "type": "string",
      "minLength": 1
    },
    "clarification_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "signal_digest",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "decisions",
    "unresolved",
    "baseline_policy"
  ],
  "additionalProperties": false
}
