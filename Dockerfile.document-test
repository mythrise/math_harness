# Document regression only; no office parser is added to the solver runtime.
ARG RUNTIME_IMAGE=cumcm-egoharness:0.5.0-rc1-test
FROM ${RUNTIME_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libreoffice-writer libreoffice-math poppler-utils fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'python-docx>=1.2,<2' 'pdf2image>=1.17,<2'
