{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "records"
  ],
  "properties": {
    "status": {
      "enum": [
        "unconfirmed",
        "used",
        "unused"
      ]
    },
    "brief_purpose": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
